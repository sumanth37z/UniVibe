# Copy this file to `.env` and adjust for your machine.

# PostgreSQL connection string used by Drizzle ORM.
# Local Postgres defaults usually work:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# No local Postgres? Quickest option (Docker):
#   docker run --name univibe-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=app_db -p 5432:5432 -d postgres:16
#
# Then apply the schema and load the demo data:
#   npx drizzle-kit push
#   npx tsx scripts/seed.ts
